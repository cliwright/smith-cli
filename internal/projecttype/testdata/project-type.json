{
  "name": "python/astral/lib",
  "version": 1,
  "description": "Python library on the Astral toolchain (uv, ruff, ty)",

  "capabilities": ["buildable", "testable", "lintable", "formattable", "packageable"],

  "tools": ["python", "uv"],

  "working_dir": "project",

  "params": {
    "config_path": {
      "default": "pyproject.toml",
      "description": "ruff/pytest config location"
    }
  },

  "environment": {
    "PYTHONUNBUFFERED": "1"
  },

  "targets": {
    "lint":   ["uv run ruff check --config '{{.config_path}}' ."],
    "format": ["uv run ruff format --config '{{.config_path}}' ."],
    "test":   ["uv run pytest -c '{{.config_path}}'"],
    "build":  ["uv build"],
    "clean":  ["rm -rf dist .venv"]
  },

  "depends_on": {
    "build": ["lint", "test"]
  }
}
